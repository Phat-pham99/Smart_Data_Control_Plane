# Application
APP_NAME="Explainable Data Lifecycle Control Plane"
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (SQLAlchemy URL; psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://lifecycle:lifecycle@localhost:5432/lifecycle

# Redis (diagnostic for ingestion; legacy Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0
# Optional overrides; fall back to REDIS_URL when unset
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Loopback-only Compose ports; change these when a port is already occupied.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Synthetic local-only MinIO credentials; do not reuse outside this demo.
MINIO_ROOT_USER=local-admin
MINIO_ROOT_PASSWORD=local-admin-password
MINIO_APP_USER=lifecycle-app
MINIO_APP_PASSWORD=local-app-password

# Host-side storage tools. Credentials must match MINIO_APP_* above.
# Compose injects its internal endpoint and scoped credentials into the API.
S3_REGION=us-east-1
S3_BUCKET=lifecycle-dev
S3_STAGING_BUCKET=lifecycle-staging
S3_ARCHIVE_BUCKET=lifecycle-archive
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=lifecycle-app
AWS_SECRET_ACCESS_KEY=local-app-password

# Reserved configuration only; authentication/admin endpoints are not implemented.
# ADMIN_API_KEY=
